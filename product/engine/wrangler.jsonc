{
  // MySI engine: remote MCP server at /mcp, setup page at /, rating page at /r/<run_id>.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-bench",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [
      { "name": "RUN", "class_name": "RunObject" },
      { "name": "REGISTRY", "class_name": "RegistryObject" },
      { "name": "PERSON", "class_name": "PersonObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RunObject", "RegistryObject"] },
    { "tag": "v2", "new_sqlite_classes": ["PersonObject"] }
  ],
  // OPENROUTER_API_KEY is a secret (`wrangler secret put OPENROUTER_API_KEY`). Without it every
  // model call is answered by the mock in src/models.ts. Lineup ids: check with `npm run check-models`.
  "vars": {
    "MAX_RUNS_PER_DAY": "20",
    "MAX_RUN_COST_USD": "2",
    "LINEUP": "[{\"id\":\"openai/gpt-5\",\"name\":\"GPT-5\",\"company\":\"OpenAI\"},{\"id\":\"google/gemini-2.5-pro\",\"name\":\"Gemini 2.5 Pro\",\"company\":\"Google\"},{\"id\":\"anthropic/claude-sonnet-4.5\",\"name\":\"Claude Sonnet 4.5\",\"company\":\"Anthropic\"}]",
    "JUDGE_POOL": "[{\"id\":\"deepseek/deepseek-chat-v3.1\",\"name\":\"DeepSeek V3.1\",\"company\":\"DeepSeek\"},{\"id\":\"mistralai/mistral-medium-3.1\",\"name\":\"Mistral Medium 3.1\",\"company\":\"Mistral\"},{\"id\":\"x-ai/grok-4.7\",\"name\":\"Grok 4.7\",\"company\":\"xAI\"}]"
  }
}
