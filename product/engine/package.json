{
  "name": "personal-bench-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.ts test/blindness.test.mjs test/golden.test.mjs",
    "test:protocol": "node --test --test-concurrency=1 test/mcp.test.mjs",
    "test:tools": "node --test --test-concurrency=1 test/tools.test.mjs test/limits.test.mjs test/identity.test.mjs test/admin.test.mjs",
    "test:all": "npm test && npm run test:protocol && npm run test:tools",
    "test:flow": "node --test test/flow.test.mjs",
    "test:pages": "node --test --test-concurrency=1 test/pages.test.mjs",
    "check-models": "node scripts/check-models.mjs",
    "eval:judges": "node scripts/eval-judges.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "~6.0.2",
    "wrangler": "^4.151.3"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.29.0",
    "zod": "^4.6.7"
  }
}
